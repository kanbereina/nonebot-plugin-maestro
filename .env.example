# NoneBot 基础配置
# ~httpx      提供 HTTP 客户端（适配器鉴权与面板 REST 调用必需）
# ~websockets 提供 WS 客户端（QQ_BOTS 中 use_websocket=true 时需要）
# WebUI 跑在自己的 uvicorn 上，不需要 NoneBot 提供 ASGI 服务端；
# 若你另有插件需要 webhook，再加上 ~fastapi 即可。
DRIVER=~httpx+~websockets
LOG_LEVEL=INFO

# QQ 适配器配置
# 面板是账号级持久配置，改动会立即对所有用户生效
QQ_IS_SANDBOX=true
QQ_BOTS='[{"id":"YOUR_BOT_ID","token":"YOUR_BOT_TOKEN","secret":"YOUR_BOT_SECRET","use_websocket":true}]'

# ==================== Maestro WebUI ====================
# 监听地址，两种启动方式共用；默认 127.0.0.1:8100
MAESTRO_HOST=127.0.0.1
MAESTRO_PORT=8100

# 方式一（推荐）：随 NoneBot 启动，bot 连接后 WebUI 才列出该机器人
#   uv run python bot.py
#
# 方式二：独立运行，不需要 bot 连接，直接读 QQ_BOTS 做纯 REST 管理
#   uv run python -m maestro
#
# 两种方式都监听 MAESTRO_HOST:MAESTRO_PORT，故不要同时启动。
