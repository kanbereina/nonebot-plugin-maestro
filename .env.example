# NoneBot 基础配置
# ~httpx 提供 HTTP 客户端（适配器鉴权与面板 REST 调用必需）
# ~websockets 供 QQ_BOTS 中 use_websocket=true 时使用；纯面板管理不需要 WS，
# 但适配器 setup() 会在任一 bot 开启 WS 时校验该 driver 是否存在
DRIVER=~httpx+~websockets
LOG_LEVEL=INFO

# QQ 适配器配置（沙箱环境示例）
# 面板是账号级持久配置，开发调试务必用沙箱，避免污染线上面板
QQ_IS_SANDBOX=true
QQ_BOTS='[{"id":"YOUR_BOT_ID","token":"YOUR_BOT_TOKEN","secret":"YOUR_BOT_SECRET","use_websocket":false}]'

# Maestro WebUI
# 启动: uv run python -m maestro
# 访问: http://127.0.0.1:8080
